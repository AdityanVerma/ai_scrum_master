generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Sprint {
  id                  String       @id @default(cuid())
  name                String
  goal                String
  startDate           DateTime
  endDate             DateTime
  totalEstimatedHours Float
  status              SprintStatus @default(PLANNED)

  tasks         SprintTask[]
  documents     Document[]
  functions     SprintFunction[]
  progressMarks ProgressMark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SprintTask {
  id          String @id @default(cuid())
  taskId      String
  title       String
  description String

  complexity     TaskComplexity
  estimatedHours Float
  status         TaskStatus     @default(TODO)

  sprintId String
  sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   TeamMember? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  // The function (feature) the task belongs to. Tasks of sprints planned
  // before Phase 8 have none until the Scrum Master tags them.
  functionId String?
  function   SprintFunction? @relation(fields: [functionId], references: [id], onDelete: SetNull)

  // Work type: Development | Documentation | Testing | Research | Deployment
  // (src/lib/work-types.ts).
  category String @default("Development")

  skills        TaskSkill[]
  dependencies  TaskDependency[] @relation("TaskDependencies")
  dependedOnBy  TaskDependency[] @relation("TaskDependents")
  tasklistTasks TasklistTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sprintId, taskId])
  @@index([functionId])
}

model SprintFunction {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Optional own timeline for its 25 / 50 / 75 marks; otherwise the sprint's.
  startDate  DateTime?
  targetDate DateTime?

  sprintId String
  sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  tasks         SprintTask[]
  documents     DocumentFunctionRelation[]
  progressMarks ProgressMark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sprintId, name])
}

// One row per progress mark reached. Planned dates are calculated when
// needed, not stored, because sprint and function dates can be edited.
model ProgressMark {
  id String @id @default(cuid())

  sprintId String
  sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  // Both empty for a sprint mark; functionId only for a function mark;
  // both for one work type of a function (e.g. its Documentation part).
  functionId String?
  function   SprintFunction? @relation(fields: [functionId], references: [id], onDelete: Cascade)
  category   String?

  // "sprint", "function:<functionId>" or "function:<functionId>:<category>".
  // Used in the unique key, because PostgreSQL treats empty (NULL) values as
  // all different, so functionId and category alone would allow duplicates.
  scope String

  mark      Int // 25, 50, 75 or 100
  reachedAt DateTime @default(now())

  @@unique([sprintId, scope, mark])
}

model TeamMember {
  id   String @id @default(cuid())
  name String
  role String

  email              String?    @unique
  passwordHash       String?
  accessRole         AccessRole @default(MEMBER)
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(true)

  createdDocuments Document[]

  skills        TeamMemberSkill[]
  assignedTasks SprintTask[]
  tasklists     DailyTasklist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMemberSkill {
  id    String @id @default(cuid())
  skill String

  memberId String
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([memberId, skill])
}

model TaskSkill {
  id    String @id @default(cuid())
  skill String

  taskId String
  task   SprintTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, skill])
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  dependsOnTaskId String

  task      SprintTask @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn SprintTask @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
}

model Document {
  id    String @id @default(cuid())
  title String
  type  String

  sourceType DocumentSourceType @default(DOCUMENT)
  content    String?
  url        String?

  source DocumentSource @default(MANUAL)

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   TeamMember? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  tags      DocumentTagRelation[]
  functions DocumentFunctionRelation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

model DocumentTag {
  id   String @id @default(cuid())
  name String

  documents DocumentTagRelation[]

  createdAt DateTime @default(now())

  @@unique([name])
}

model DocumentTagRelation {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  tagId String
  tag   DocumentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([documentId, tagId])
}

model DocumentFunctionRelation {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  functionId String
  function   SprintFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([documentId, functionId])
}

model DailyTasklist {
  id String @id @default(cuid())

  memberId String
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  date   DateTime
  status String   @default("DRAFT")

  sodCapturedAt DateTime?
  eodCapturedAt DateTime?

  tasks     TasklistTask[]
  snapshots TasklistSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, date])
  @@index([memberId])
}

model TasklistTask {
  id         String @id @default(cuid())
  tasklistId String

  title         String
  category      String
  estimatedMins Int
  order         Int
  status        String @default("PENDING")
  priority      String @default("MEDIUM")

  carriedForwardFromId String?

  // Optional link to a sprint task assigned to this person. Kept as empty
  // (not deleted) if the sprint task goes, so the day's record stays.
  sprintTaskId String?
  sprintTask   SprintTask? @relation(fields: [sprintTaskId], references: [id], onDelete: SetNull)

  // Time actually spent that day, entered at End Day.
  spentMins Int?

  // Estimate for multi-day work outside the sprint (e.g. a pilot), copied
  // when the task is carried over, so time can be totalled across days.
  totalEstimateMins Int?

  parentTaskId String?
  parentTask   TasklistTask?  @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  subtasks     TasklistTask[] @relation("TaskSubtasks")

  tasklist DailyTasklist @relation(fields: [tasklistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tasklistId])
  @@index([sprintTaskId])
}

model TasklistSnapshot {
  id String @id @default(cuid())

  tasklistId String
  tasklist   DailyTasklist @relation(fields: [tasklistId], references: [id], onDelete: Cascade)

  type       String
  capturedAt DateTime @default(now())

  tasks Json

  @@index([tasklistId])
  @@index([tasklistId, type])
}

enum AccessRole {
  SCRUM_MASTER
  MEMBER
}

enum TaskComplexity {
  LOW
  MEDIUM
  HIGH
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum DocumentSource {
  MANUAL
  AI_GENERATED
}

enum DocumentSourceType {
  DOCUMENT
  LINK
}
